# A vendor runs the watcher and the push box. None of these belong in the phone.
# Copy to .env. Do not commit the copy.

# The box watches this relay for messages and calls. This is the default when
# the line is missing, so say so here instead of leaving it implicit.
CIPHER_RELAYS=wss://relay.primal.net
CIPHER_PUSH_DIR=./data/push-gateway
PUSH_PORT=8787
APNS_HOST=https://api.push.apple.com

# Required. The watcher refuses to listen without it. Paste it on the watcher URL.
WATCH_TOKEN=
WATCH_PORT=8788

# One of these is required for the watcher to listen. Set both if you take both coins.
# Monero wallet RPC. The wallet must be open.
XMR_WALLET_RPC=http://127.0.0.1:18083
# Bitcoin Core RPC. User and password stay in the URL. The watcher sends them as basic auth.
# scantxoutset does not need a wallet or a transaction index.
BTC_RPC_URL=http://user:password@127.0.0.1:8332

# Android push. A Firebase service-account JSON. Without this file the gateway stores the token and does not send.
FCM_SERVICE_ACCOUNT=

# iOS push. All four are required or the gateway does not send. No device has been buzzed.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
